meta {
  name: Create
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/templates
  body: json
  auth: none
}

body:json {
  {
    "templateCode": "order_created_email_customer",
    "notificationTypeCode": "order_created",
    "categoryCode": "orders",
    "channel": "email",
    "userType": "customer",
    "subject": "Order Confirmation - {{orderNumber}}",
    "body": "Dear {{customerName}},\n\nYour order {{orderNumber}} has been confirmed.\n\nThank you!",
    "variables": ["orderNumber", "customerName"],
    "isActive": true
  }
}

docs {
  # Create Template
  
  Creates a new notification template.
  
  ## Request Body
  
  | Field | Type | Required | Description |
  |-------|------|----------|-------------|
  | `templateCode` | string | **Required** | Unique template code |
  | `notificationTypeCode` | string | **Required** | Type code reference |
  | `categoryCode` | string | **Required** | Category code reference |
  | `channel` | string | **Required** | Channel code reference |
  | `userType` | string | **Required** | User type (customer, driver, admin) |
  | `subject` | string | Optional | Template subject (for email) |
  | `body` | string | **Required** | Template body with variables |
  | `variables` | array | Optional | List of variable names used in template |
  | `isActive` | boolean | Optional | Active status (default: true) |
}
