meta {
  name: Get All
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/templates?channel=email&userType=customer
  body: none
  auth: none
}

params:query {
  channel: email
  userType: customer
  ~notificationTypeCode: order_created
  ~categoryCode: orders
  ~isActive: true
  ~limit: 20
  ~page: 1
}

docs {
  # List Templates
  
  Retrieves all templates with optional filters.
  
  ## Query Parameters
  
  | Parameter | Type | Required | Description |
  |-----------|------|----------|-------------|
  | `notificationTypeCode` | string | Optional | Filter by type code |
  | `categoryCode` | string | Optional | Filter by category code |
  | `channel` | string | Optional | Filter by channel |
  | `userType` | string | Optional | Filter by user type |
  | `isActive` | boolean | Optional | Filter by active status |
  | `limit` | number | Optional | Number of results (default: 20) |
  | `page` | number | Optional | Page number for pagination (default: 1) |
}
