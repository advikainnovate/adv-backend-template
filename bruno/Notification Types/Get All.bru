meta {
  name: Get All
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/notification-types?categoryCode=orders&isActive=true
  body: none
  auth: none
}

params:query {
  categoryCode: orders
  isActive: true
  ~priority: MEDIUM
}

docs {
  # List Notification Types
  
  Retrieves all notification types with optional filters.
  
  ## Query Parameters
  
  | Parameter | Type | Required | Description |
  |-----------|------|----------|-------------|
  | `categoryCode` | string | Optional | Filter by category code |
  | `priority` | string | Optional | Filter by priority |
  | `isActive` | boolean | Optional | Filter by active status |
}
