meta {
  name: Generate For User Token
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/user-preferences/generate
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

docs {
  # Generate User Preferences
  
  Automatically initializes default notification preferences for a user.
  
  - If a token is provided, the user ID will be resolved from the token.
  - If a user ID is passed in the URL (e.g. `/generate/:userId`), it will generate preferences for that user ID.
}
