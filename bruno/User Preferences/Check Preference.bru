meta {
  name: Check Preference
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/user-preferences/check?userId=user123&userType=customer&categoryCode=orders&channel=email
  body: none
  auth: none
}

params:query {
  userId: user123
  userType: customer
  categoryCode: orders
  channel: email
}

docs {
  # Check User Preference
  
  Checks if a user has notifications enabled for a specific category and channel.
  Returns `isEnabled: true` if no preference exists (default behavior).
  
  ## Query Parameters
  
  | Parameter | Type | Required | Description |
  |-----------|------|----------|-------------|
  | `userId` | string | **Required** | User ID |
  | `userType` | string | **Required** | User type |
  | `categoryCode` | string | **Required** | Category code |
  | `channel` | string | **Required** | Channel code |
  
  ## Example Response
  ```json
  {
    "success": true,
    "code": 200,
    "message": "Preference check completed",
    "data": {
      "isEnabled": true,
      "preference": { ... } or null
    }
  }
  ```
}
