meta {
  name: Send Direct Notification
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/test-notifications/without-sqs
  body: json
  auth: none
}

body:json {
  {
    "userId": "user123",
    "userType": "customer",
    "notificationTypeCode": "order_created",
    "channel": "email",
    "recipient": "candyurahara@gmail.com",
    "variables": {
      "orderNumber": "ORD-TEST-99",
      "customerName": "Test Customer",
      "orderTotal": "$199.99"
    }
  }
}
