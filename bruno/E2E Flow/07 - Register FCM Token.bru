meta {
  name: 07 - Register FCM Token
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/fcm
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "userId": "{{userId}}",
    "userType": "{{userType}}",
    "deviceToken": "{{fcmDeviceToken}}",
    "platform": "web"
  }
}

vars:pre-request {
  fcmDeviceToken: mock-token
}

script:pre-request {
  const timestamp = Date.now();
  bru.setVar("fcmDeviceToken", `fcm_test_token_${timestamp}`);
}

docs {
  # 07 - Register FCM Token
  
  Registers a mock FCM device token for the authenticated user to verify that push notifications resolve and attempt to dispatch.
}
