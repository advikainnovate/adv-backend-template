meta {
  name: 10 - Send Push Notification
  type: http
  seq: 10
}

post {
  url: {{baseUrl}}/notifications/send?useQueue=true
  body: json
  auth: none
}

params:query {
  useQueue: true
}

body:json {
  {
    "userId": "{{userId}}",
    "userType": "{{userType}}",
    "notificationTypeCode": "{{typeCode}}",
    "channel": "PUSH",
    "variables": {
      "customerName": "Yousuf",
      "orderNumber": "ORD-E2E-999",
      "orderTotal": "$1,499.00"
    }
  }
}

docs {
  # 10 - Send Push Notification
  
  Triggers push notification dispatch to all active registered tokens for the user ID using FCM.
}
