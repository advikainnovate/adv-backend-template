meta {
  name: 11 - Send Web Notification
  type: http
  seq: 11
}

post {
  url: {{baseUrl}}/notifications/send?useQueue=true
  body: json
  auth: none
}

params:query {
  useQueue: true
}

body:json {
  {
    "userId": "{{userId}}",
    "userType": "{{userType}}",
    "notificationTypeCode": "{{typeCode}}",
    "channel": "WEB",
    "recipient": "web-notification-recipient-placeholder",
    "variables": {
      "orderNumber": "ORD-E2E-999",
      "orderTotal": "$1,499.00"
    }
  }
}

docs {
  # 11 - Send Web Notification
  
  Triggers a database-only web notification that can be queried by the web application frontend.
}
