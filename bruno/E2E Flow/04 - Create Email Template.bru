meta {
  name: 04 - Create Email Template
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/templates
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "templateCode": "{{emailTemplateCode}}",
    "notificationTypeCode": "{{typeCode}}",
    "categoryCode": "{{categoryCode}}",
    "channel": "EMAIL",
    "userType": "{{userType}}",
    "subject": "Order Completed: #{{orderNumber}}",
    "body": "<html>\n<body style=\"font-family: Arial, sans-serif; margin: 0; padding: 20px; background-color: #f9f9f9;\">\n  <div style=\"max-width: 600px; margin: 0 auto; background: #ffffff; padding: 25px; border-radius: 8px; border: 1px solid #e0e0e0;\">\n    <div style=\"text-align: center; margin-bottom: 25px;\">\n      <img src=\"https://placehold.co/200x60/1e293b/ffffff?text=DealAmaze\" alt=\"DealAmaze Logo\" style=\"max-height: 50px;\" />\n    </div>\n    <h2 style=\"color: #1e293b; border-bottom: 2px solid #3b82f6; padding-bottom: 10px;\">Order Confirmation</h2>\n    <p>Dear <strong>{{customerName}}</strong>,</p>\n    <p>Your order has been completed successfully. Here are the details:</p>\n    <table style=\"width: 100%; border-collapse: collapse; margin: 20px 0;\">\n      <thead>\n        <tr style=\"background-color: #f1f5f9;\">\n          <th style=\"text-align: left; padding: 10px; border: 1px solid #cbd5e1;\">Item Details</th>\n          <th style=\"text-align: right; padding: 10px; border: 1px solid #cbd5e1;\">Price</th>\n        </tr>\n      </thead>\n      <tbody>\n        <tr>\n          <td style=\"padding: 10px; border: 1px solid #cbd5e1;\">Order #{{orderNumber}} (E2E Integration Test)</td>\n          <td style=\"text-align: right; padding: 10px; border: 1px solid #cbd5e1;\">{{orderTotal}}</td>\n        </tr>\n      </tbody>\n    </table>\n    <div style=\"margin-top: 25px; padding-top: 15px; border-top: 1px solid #e2e8f0; text-align: center; color: #64748b; font-size: 12px;\">\n      Thank you for shopping with DealAmaze!\n    </div>\n  </div>\n</body>\n</html>",
    "variables": ["customerName", "orderNumber", "orderTotal"],
    "isActive": true
  }
}

script:pre-request {
  const timestamp = Date.now();
  bru.setVar("emailTemplateCode", `e2e_email_${timestamp}`);
}

docs {
  # 04 - Create Email Template
  
  Creates a beautiful HTML-formatted order completion email template containing structural tables and placeholder variables.
}
