meta {
  name: 05 - Create Push Template
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/templates
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "templateCode": "{{pushTemplateCode}}",
    "notificationTypeCode": "{{typeCode}}",
    "categoryCode": "{{categoryCode}}",
    "channel": "PUSH",
    "userType": "{{userType}}",
    "subject": "Order Completed: #{{orderNumber}}",
    "body": "Hi {{customerName}}, your order of {{orderTotal}} is complete.",
    "variables": ["customerName", "orderNumber", "orderTotal"],
    "isActive": true
  }
}

script:pre-request {
  const timestamp = Date.now();
  bru.setVar("pushTemplateCode", `e2e_push_${timestamp}`);
}

docs {
  # 05 - Create Push Template
  
  Creates a plain-text notification template matching the PUSH channel to send alerts via FCM.
}
