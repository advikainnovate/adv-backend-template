meta {
  name: 03 - Create Notification Type
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/notification-types
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "categoryCode": "{{categoryCode}}",
    "name": "Order Completed E2E",
    "description": "Notification type sent when an order is completed",
    "priority": "HIGH",
    "isActive": true
  }
}

tests {
  if (res.body && res.body.data && res.body.data.code) {
    bru.setVar("typeCode", res.body.data.code);
  }
}

docs {
  # 03 - Create Notification Type
  
  Creates a new notification type associated with the previously created category and stores the type code as `typeCode`.
}
