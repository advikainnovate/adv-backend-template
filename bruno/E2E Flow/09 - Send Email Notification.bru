meta {
  name: 09 - Send Email Notification
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/notifications/send?useQueue=true
  body: json
  auth: none
}

params:query {
  useQueue: true
}

body:json {
  {
    "userId": "{{userId}}",
    "userType": "{{userType}}",
    "notificationTypeCode": "{{typeCode}}",
    "channel": "EMAIL",
    "recipient": "mcctrix@gmail.com",
    "variables": {
      "customerName": "Yousuf",
      "orderNumber": "ORD-E2E-999",
      "orderTotal": "$1,499.00"
    }
  }
}

docs {
  # 09 - Send Email Notification
  
  Triggers the email delivery flow directly via the SMTP provider to the user's gmail address.
}
