meta {
  name: 02 - Create Category
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/categories
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "name": "E2E Order Updates",
    "description": "Category for complete E2E order flow verification",
    "isActive": true
  }
}

tests {
  if (res.body && res.body.data && res.body.data.code) {
    bru.setVar("categoryCode", res.body.data.code);
  }
}

docs {
  # 02 - Create Category
  
  Creates a new notification category for E2E testing and stores the resulting code as `categoryCode`.
}
