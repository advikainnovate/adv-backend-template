meta {
  name: 06 - Create Web Template
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/templates
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "templateCode": "{{webTemplateCode}}",
    "notificationTypeCode": "{{typeCode}}",
    "categoryCode": "{{categoryCode}}",
    "channel": "WEB",
    "userType": "{{userType}}",
    "subject": "Order Completed: #{{orderNumber}}",
    "body": "Your order #{{orderNumber}} is complete. Total: {{orderTotal}}.",
    "variables": ["orderNumber", "orderTotal"],
    "isActive": true
  }
}

script:pre-request {
  const timestamp = Date.now();
  bru.setVar("webTemplateCode", `e2e_web_${timestamp}`);
}

docs {
  # 06 - Create Web Template
  
  Creates a template matching the WEB channel to store alerts in the DB for local client UI retrieval.
}
