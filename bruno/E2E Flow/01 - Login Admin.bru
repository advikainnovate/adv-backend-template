meta {
  name: 01 - Login Admin
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

body:json {
  {
    "username": "ctrix@dealamaze.com",
    "password": "Qwerty123"
  }
}

tests {
  if (res.body && res.body.data) {
    if (res.body.data.accessToken) {
      bru.setVar("accessToken", res.body.data.accessToken);
    }
    if (res.body.data.id) {
      bru.setVar("userId", res.body.data.id);
    }
    if (res.body.data.role) {
      bru.setVar("userType", res.body.data.role);
    }
  }
}

docs {
  # 01 - Login Admin
  
  Authenticates the administrator using their credentials and stores the `accessToken`, `userId`, and `userType` globally for subsequent steps.
}
