meta {
  name: Create
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/role-preferences
  body: json
  auth: none
}

body:json {
  {
    "userType": "customer",
    "categoryCode": "orders",
    "channel": "email",
    "isEnabled": true
  }
}

docs {
  # Create Role Preference
  
  Creates a new default notification preference for a specific user type / role.
  
  ## Request Body
  
  | Field | Type | Required | Description |
  |-------|------|----------|-------------|
  | `userType` | string | **Required** | User type / role (e.g. customer, driver, admin) |
  | `categoryCode` | string | **Required** | Category code |
  | `channel` | string | **Required** | Channel code (email, sms, push, etc.) |
  | `isEnabled` | boolean | Optional | Whether notifications are enabled (default: true) |
}
