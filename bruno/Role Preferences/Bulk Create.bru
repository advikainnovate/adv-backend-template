meta {
  name: Bulk Create
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/role-preferences/bulk
  body: json
  auth: none
}

body:json {
  {
    "userTypes": ["customer", "driver"],
    "channels": ["email", "push"],
    "isEnabled": true
  }
}

docs {
  # Bulk Create/Update Role Preferences
  
  Creates or updates default notification preferences for multiple user types and channels across all active notification categories.
  
  ## Request Body
  
  | Field | Type | Required | Description |
  |-------|------|----------|-------------|
  | `userTypes` | string[] | **Required** | List of user types / roles |
  | `channels` | string[] | **Required** | List of channel codes |
  | `isEnabled` | boolean | **Required** | Whether notifications are enabled for these combinations |
}
