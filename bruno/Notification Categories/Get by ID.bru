meta {
  name: Get by ID
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/categories/:id
  body: none
  auth: none
}

params:path {
  id: 
}

docs {
  # Get Category by ID
  
  Retrieves a single category by its UUID.
  
  ## URL Parameters
  
  | Parameter | Type | Required | Description |
  |-----------|------|----------|-------------|
  | `id` | UUID | **Required** | Category ID |
  
  ## Example Response
  ```json
  {
    "success": true,
    "code": 200,
    "message": "Category retrieved successfully",
    "data": {
      "id": "uuid",
      "code": "orders",
      "name": "Orders",
      "description": "Order related notifications",
      "isActive": true,
      "createdAt": "2026-01-25T10:00:00.000Z",
      "updatedAt": "2026-01-25T10:00:00.000Z"
    }
  }
  ```
}
