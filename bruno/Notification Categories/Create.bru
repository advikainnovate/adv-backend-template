meta {
  name: Create 
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/categories
  body: json
  auth: none
}

body:json {
  {
    "code": "orders",
    "name": "Orders",
    "description": "Order related notifications",
    "isActive": true
  }
}

docs {
  # Create Category
  
  Creates a new notification category.
  
  ## Request Body
  
  | Field | Type | Required | Description |
  |-------|------|----------|-------------|
  | `code` | string | **Required** | Unique category code (lowercase) |
  | `name` | string | **Required** | Category display name |
  | `description` | string | Optional | Category description |
  | `isActive` | boolean | Optional | Active status (default: true) |
  
  ## Example Response
  ```json
  {
    "success": true,
    "code": 201,
    "message": "Category created successfully",
    "data": {
      "id": "uuid",
      "code": "orders",
      "name": "Orders",
      "description": "Order related notifications",
      "isActive": true,
      "createdAt": "2026-01-25T10:00:00.000Z",
      "updatedAt": "2026-01-25T10:00:00.000Z"
    }
  }
  ```
}
