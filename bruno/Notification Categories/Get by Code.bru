meta {
  name: Get by Code
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/categories/code/:code
  body: none
  auth: none
}

params:path {
  code: orders
}

docs {
  # Get Category by Code
  
  Retrieves a single category by its unique code.
  
  ## URL Parameters
  
  | Parameter | Type | Required | Description |
  |-----------|------|----------|-------------|
  | `code` | string | **Required** | Category code |
  
  ## Example Response
  ```json
  {
    "success": true,
    "code": 200,
    "message": "Category retrieved successfully",
    "data": {
      "id": "uuid",
      "code": "orders",
      "name": "Orders",
      "description": "Order related notifications",
      "isActive": true,
      "createdAt": "2026-01-25T10:00:00.000Z",
      "updatedAt": "2026-01-25T10:00:00.000Z"
    }
  }
  ```
}
