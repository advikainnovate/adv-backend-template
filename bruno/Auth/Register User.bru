meta {
  name: Register User
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/users/register
  body: json
  auth: none
}

body:json {
  {
    "userType": "admin",
    "display_name": "Ctrix",
    "email": "ctrix@dealamaze.com",
    "countryCode": "+91",
    "phoneNumber": "1234567890",
    "password": "Qwerty123",
    "gender": "male"
  }
}

tests {
  if (res.body && res.body.data && res.body.data.accessToken) {
    bru.setVar("accessToken", res.body.data.accessToken);
  }
}

docs {
  # Register User
  
  Create a new user account.
  
  ## Request Body
  
  | Field | Type | Required | Description |
  |-------|------|----------|-------------|
  | `userType` | string | **Required** | User type, must match system constants (e.g. `admin`) |
  | `display_name` | string | Optional | Display name. If not provided, it defaults to the username (email) |
  | `email` | string | **Required** | Valid email address (must be unique) |
  | `countryCode` | string | **Required** | Country code (e.g., +1) |
  | `phoneNumber` | string | **Required** | Phone number (must be unique) |
  | `password` | string | **Required** | User password |
  | `gender` | string | **Required** | Gender: male, female, other |
  
  ## Example Response
  ```json
  {
    "success": true,
    "code": 201,
    "message": "Successfully created",
    "data": {
      "id": "uuid",
      "idd": "NXSU01000000001",
      "userType": "admin",
      "username": "john.doe@example.com",
      "display_name": "John Doe",
      "email": "john.doe@example.com",
      "countryCode": "+1",
      "phoneNumber": "1234567890",
      "gender": "male",
      "status": "active",
      "accessToken": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...",
      "refreshToken": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
    }
  }
  ```
  
  ## Notes
  - Email and phone number must be unique
  - Password is automatically hashed
  - User status is set to 'active' by default
  - Username is set to email
  - User ID (idd) is auto-generated based on userType
}
