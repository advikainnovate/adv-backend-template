}

params:query {
  ~userId: user123
  ~userType: consumer
  ~isActive: true
  ~platform: android
  ~limit: 20
  ~page: 1
}

docs {
  # List All FCM Tokens
  
  Retrieves registered FCM device tokens with optional query filtering and pagination.
  
  ## Query Parameters
  
  | Parameter | Type | Required | Description |
  |-----------|------|----------|-------------|
  | `userId` | string | Optional | Filter by user ID |
  | `userType` | string | Optional | Filter by user type |
  | `isActive` | boolean | Optional | Filter by active status (`true` / `false`) |
  | `platform` | string | Optional | Filter by platform (`android`, `ios`, `web`) |
  | `limit` | number | Optional | Number of results to return (default: 20) |
  | `page` | number | Optional | Page number for pagination (default: 1) |
}
