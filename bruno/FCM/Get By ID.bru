meta {
  name: Get By ID
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/fcm/:id
  body: none
  auth: none
}

params:path {
  id: token-uuid-here
}

docs {
  # Get FCM Token By ID
  
  Retrieves a specific FCM device token registration record by its UUID.
  
  ## Path Parameters
  
  | Parameter | Type | Required | Description |
  |-----------|------|----------|-------------|
  | `id` | string (UUID) | **Required** | The UUID of the device token record |
}
