meta {
  name: Mark as Read
  type: http
  seq: 4
}

patch {
  url: {{baseUrl}}/notifications/:id/read
  body: none
  auth: none
}

params:path {
  id: 
}

docs {
  # Mark Notification as Read
  
  Marks a single notification as read by its unique UUID.
  
  ## URL Parameters
  
  | Parameter | Type | Required | Description |
  |-----------|------|----------|-------------|
  | `id` | UUID | **Required** | The ID of the notification to mark as read |
  
  ## Example Response
  ```json
  {
    "success": true,
    "code": 200,
    "message": "Notification marked as read successfully",
    "data": {
      "id": "uuid",
      "userId": "user123",
      "userType": "customer",
      "isRead": true,
      ...
    }
  }
  ```
}
