meta {
  name: Get All
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/notifications?userId=user123&limit=50
  body: none
  auth: none
}

params:query {
  ~userId: user123
  ~userType: customer
  ~notificationTypeCode: order_created
  ~categoryCode: orders
  ~channel: email
  ~status: SENT
  ~isRead: false
  ~limit: 20
  ~page: 1
}

docs {
  # List Notifications
  
  Retrieves all notifications with optional filters.
  
  ## Query Parameters
  
  | Parameter | Type | Required | Description |
  |-----------|------|----------|-------------|
  | `userId` | string | Optional | Filter by user ID |
  | `userType` | string | Optional | Filter by user type |
  | `notificationTypeCode` | string | Optional | Filter by notification type |
  | `categoryCode` | string | Optional | Filter by category |
  | `channel` | string | Optional | Filter by channel |
  | `status` | string | Optional | Filter by status (PENDING, SENT, FAILED) |
  | `isRead` | boolean | Optional | Filter by read status (true, false) |
  | `limit` | number | Optional | Number of results (default: 20) |
  | `page` | number | Optional | Page number for pagination (default: 1) |
}
