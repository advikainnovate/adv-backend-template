{
    "name": "dealamaze-notifications-service",
    "version": "1.0.0",
    "description": "Notification Microservice for DealAmaze Platform",
    "main": "index.js",
    "scripts": {
        "format:check": "prettier --check .",
        "format": "prettier --write .",
        "lint:check": "eslint .",
        "lint": "eslint --fix .",
        "test": "npm run test",
        "prestart": "npx sequelize-cli db:migrate",
        "db:seed": "npx sequelize-cli db:seed:all",
        "db:reset": "npx sequelize-cli db:migrate:undo:all && npx sequelize-cli db:migrate",
        "start": "node server.js",
        "dev": "nodemon server.js",
        "worker": "node src/worker.js",
        "prod:start": "pm2 start npm --name auth-go -- run start",
        "prod:restart": "pm2 restart auth-go"
    },
    "author": "",
    "license": "ISC",
    "dependencies": {
        "@aws-sdk/client-sqs": "^3.972.0",
        "bcrypt": "^6.0.0",
        "compression": "^1.8.0",
        "cors": "^2.8.5",
        "dotenv": "^16.6.1",
        "express": "^5.1.0",
        "firebase-admin": "^13.10.0",
        "helmet": "^8.1.0",
        "joi": "^17.13.3",
        "jsonwebtoken": "^9.0.2",
        "morgan": "^1.10.0",
        "multer": "^2.0.0",
        "nodemailer": "^7.0.12",
        "pg": "^8.16.0",
        "pgsn": "^1.1.3",
        "pino": "^9.7.0",
        "pino-pretty": "^13.0.0",
        "sequelize": "^6.37.7",
        "swagger-jsdoc": "^6.2.8",
        "swagger-ui-express": "^5.0.1",
        "uuid": "^11.1.0"
    },
    "devDependencies": {
        "axios": "^1.13.4",
        "cross-env": "^7.0.3",
        "dotenv-cli": "^10.0.0",
        "eslint": "^9.27.0",
        "eslint-config-prettier": "^10.1.5",
        "nodemon": "^3.1.10",
        "prettier": "^3.5.3",
        "sequelize-cli": "^6.6.3"
    }
}
