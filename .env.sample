# Application
PORT=5002
NODE_ENV=development
BASE_URL=http://localhost:5002

# Database
DB_USERNAME=postgres
DB_PASSWORD=password
DB_NAME=dealamaze_notifications
DB_HOST=127.0.0.1
DB_DIALECT=postgres
DB_PORT=5432

# JWT
ACCESS_TOKEN_SECRET=your_access_token_secret_here
REFRESH_TOKEN_SECRET=your_refresh_token_secret_here

# SMTP Email Configuration
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=email@id.com
SMTP_PASS=your_smtp_password_here
SMTP_FROM=DealAmaze <email@id.com>

# AWS Configuration
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_REGION=us-east-1
AWS_SQS_ORDERS_URL=https://sqs.us-east-1.amazonaws.com/123456789012/orders-queue
AWS_SQS_PROMOTIONS_URL=https://sqs.us-east-1.amazonaws.com/123456789012/promotions-queue

# Firebase Cloud Messaging (FCM)
FCM_PROJECT_ID=your-firebase-project-id
FCM_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-firebase-project-id.iam.gserviceaccount.com
FCM_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"
